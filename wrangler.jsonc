{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ms365-mcp",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": true,
  "kv_namespaces": [{ "binding": "OAUTH_KV", "id": "REPLACE_WITH_KV_ID" }],
  "vars": {
    "PUBLIC_BASE_URL": "https://ms365-mcp.REPLACE_WITH_SUBDOMAIN.workers.dev",
    "MS365_TENANT_ID": "5f291a8a-5d66-40e2-8940-1f76a4348c2b",
    "ALLOWED_USERS": "mia@mia.cx"
  }
  // Secrets (wrangler secret put): MS365_APP_CLIENT_ID, MS365_APP_CLIENT_SECRET, TOKEN_ENC_KEY (base64url, 32 bytes)
}
