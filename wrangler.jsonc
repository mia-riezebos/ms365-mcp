{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ms365-mcp",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": false,
  "routes": [{ "pattern": "ms.mia.cx", "custom_domain": true }],
  "observability": { "enabled": true },
  "kv_namespaces": [{ "binding": "OAUTH_KV", "id": "ed4977662761496eb967394335017cdb" }],
  "vars": {
    "PUBLIC_BASE_URL": "https://ms.mia.cx",
    "MS365_TENANT_ID": "common"
  }
  // MS365_TENANT_ID: "common" (any work/school or personal account), "organizations", or one tenant id.
  // Optional vars: ALLOWED_TENANTS, ALLOWED_USERS, ALLOWED_REDIRECT_HOSTS (comma-separated).
  // Secrets (wrangler secret put): MS365_APP_CLIENT_ID, MS365_APP_CLIENT_SECRET, TOKEN_ENC_KEY (base64url, 32 bytes)
}
